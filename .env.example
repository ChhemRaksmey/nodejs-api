NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=my_api
DB_USER=postgres
DB_PASS=postgres
DB_LOGGING=false
# Dev convenience: sequelize.sync({ alter: true }). Use migrations in production.
DB_SYNC=true

JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=1d

UPLOAD_DIR=uploads
UPLOAD_MAX_SIZE_MB=10
UPLOAD_MAX_FILES=10

# Optional: auto-create an admin user at startup if none exists with this email
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@12345
